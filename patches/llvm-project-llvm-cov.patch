+static bool isLoopConditionBranch(const coverage::CountedRegion &R,
+                                  const std::vector<std::string> &Lines) {
+  // 行号非法直接返回 false
+  if (R.LineStart == 0 || R.LineStart >= Lines.size())
+    return false;
+
+  llvm::StringRef RawLine(Lines[R.LineStart]);
+
+  // 去掉左侧缩进（空格、Tab 都会被干掉）
+  llvm::StringRef Trimmed = RawLine.ltrim();
+
+  // 这里故意不再用 ColumnStart 了，避免和缩进对不齐。
+  // 只要这一行（去掉缩进）是以 while/for/do 开头，就认为是循环头。
+  return Trimmed.starts_with("while") ||
+         Trimmed.starts_with("for")   ||
+         Trimmed.starts_with("do");
+}
