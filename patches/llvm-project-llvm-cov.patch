+// 收集零覆盖分支：两侧都未执行
+static std::vector<OneSidedBranchPoint> collectFileZeroCoveredBranches(
+    const coverage::CoverageData &FC,
+    llvm::StringRef Filename) {
+
+  auto Lines = loadFileLines(Filename);
+  std::vector<OneSidedBranchPoint> BranchPoints;
+
+  auto Branches = FC.getBranches();
+  if (Branches.empty())
+    return BranchPoints;
+
+  for (const auto &B : Branches) {
+    // 跳过循环条件分支
+    if (isLoopConditionBranch(B, Lines))
+      continue;
+    // 只处理零覆盖分支
+    if (!isZeroCoveredBranch(B))
+      continue;
+
+    uint64_t TrueCount = B.ExecutionCount;  // 应该为0
+    uint64_t FalseCount = B.FalseExecutionCount;  // 应该为0
+
+    double Average = 0.0;
+    double Variance = 0.0;
+
+    std::string Code;
+    if (B.LineStart > 0 && B.LineStart < Lines.size())
+      Code = Lines[B.LineStart];
+    else
+      Code = "";
+
+    const char *Status = "zero_covered";
+
+    OneSidedBranchPoint Point;
+    Point.Filename = Filename.str();
+    Point.Line = B.LineStart;
+    Point.Col = B.ColumnStart;
+    Point.Code = Code;
+    Point.TrueCount = TrueCount;
+    Point.FalseCount = FalseCount;
+    Point.Status = Status;
+    Point.NumZeroSuccessors = 2;  // 两侧都是零
+    Point.SuccessorVariance = Variance;
+    Point.SuccessorAverage = Average;
+
+    // 标记为非分支组
+    Point.IsPartOfGroup = false;
+    Point.GroupType = BGT_SingleIf;
+    Point.GroupSize = 1;
+    Point.GroupIndex = 0;
+
+    // 初始化新增字段
+    Point.CaseBodyLine = 0;
+    Point.CaseBodyCode = "";
+    Point.SwitchStatementLine = 0;
+    Point.IfStatement = "";
+
+    // 检查是否是else if
+    llvm::StringRef CodeRef(Code);
+    if (CodeRef.contains("else if")) {
+      Point.IfStatement = findIfStatement(B.LineStart, Lines);
+      Point.GroupType = BGT_IfElseChain;
+    }
+
+    BranchPoints.push_back(Point);
+  }
+
+  return BranchPoints;
+}
