+static std::string compactLower(StringRef Text) {
+  std::string Out;
+  Out.reserve(Text.size());
+  for (char Ch : Text) {
+    unsigned char U = static_cast<unsigned char>(Ch);
+    if (std::isspace(U))
+      continue;
+    Out.push_back(static_cast<char>(std::tolower(U)));
+  }
+  return Out;
+}
+
+static bool isPointerLikeToken(StringRef Token) {
+  if (Token.empty())
+    return false;
+
+  size_t I = 0;
+  auto consumeIdent = [&](size_t &Pos) -> bool {
+    if (Pos >= Token.size())
+      return false;
+    unsigned char First = static_cast<unsigned char>(Token[Pos]);
+    if (!(std::isalpha(First) || Token[Pos] == '_'))
+      return false;
+    ++Pos;
+    while (Pos < Token.size()) {
+      unsigned char Ch = static_cast<unsigned char>(Token[Pos]);
+      if (!(std::isalnum(Ch) || Token[Pos] == '_'))
+        break;
+      ++Pos;
+    }
+    return true;
+  };
+
+  if (!consumeIdent(I))
+    return false;
+
+  while (I < Token.size()) {
+    if (Token.substr(I).starts_with("->"))
+      I += 2;
+    else if (Token[I] == '.')
+      ++I;
+    else
+      return false;
+
+    if (!consumeIdent(I))
+      return false;
+  }
+
+  return true;
+}
+
+static bool looksLikeNullGuardCondition(StringRef IfCode) {
+  size_t Open = IfCode.find('(');
+  size_t Close = IfCode.rfind(')');
+  if (Open == StringRef::npos || Close == StringRef::npos || Close <= Open)
+    return false;
+
+  std::string Normalized = compactLower(IfCode.slice(Open + 1, Close));
+  if (Normalized.empty())
+    return false;
+
+  if (Normalized.find("==null") != std::string::npos ||
+      Normalized.find("null==") != std::string::npos ||
+      Normalized.find("==nullptr") != std::string::npos ||
+      Normalized.find("nullptr==") != std::string::npos)
+    return true;
+
+  if (!Normalized.empty() && Normalized.front() == '!') {
+    StringRef Inner(Normalized);
+    Inner = Inner.drop_front().trim();
+    if (Inner.starts_with("(") && Inner.ends_with(")"))
+      Inner = Inner.drop_front().drop_back().trim();
+    return isPointerLikeToken(Inner);
+  }
+
+  return false;
+}
+
+static bool isIgnorableControlLine(StringRef Line) {
+  StringRef Trimmed = Line.trim();
+  return Trimmed.empty() || Trimmed == "{" || Trimmed == "}" ||
+         Trimmed.starts_with("//") || Trimmed.starts_with("/*") ||
+         Trimmed.starts_with("*");
+}
+
+static const char *exitKindForStatement(StringRef Line) {
+  StringRef Trimmed = Line.trim();
+  if (Trimmed.starts_with("return"))
+    return "return";
+  if (Trimmed.starts_with("goto"))
+    return "goto";
+  return nullptr;
+}
+
+static const char *findImmediateExitInSingleStatementBlock(
+    unsigned StartLine, const std::vector<std::string> &Lines) {
+  const char *ExitKind = nullptr;
+  for (unsigned I = StartLine; I < Lines.size() && I < StartLine + 8; ++I) {
+    StringRef Trimmed = StringRef(Lines[I]).trim();
+    if (isIgnorableControlLine(Trimmed))
+      continue;
+
+    if (const char *Kind = exitKindForStatement(Trimmed)) {
+      if (ExitKind != nullptr)
+        return nullptr;
+      ExitKind = Kind;
+      continue;
+    }
+
+    if (Trimmed == "}" || Trimmed.ends_with("}"))
+      return ExitKind;
+
+    return nullptr;
+  }
+  return nullptr;
+}
+
+static const char *findImmediateExitOnTrueSide(
+    unsigned IfLine, const std::vector<std::string> &Lines) {
+  if (IfLine >= Lines.size())
+    return nullptr;
+
+  StringRef Trimmed = StringRef(Lines[IfLine]).trim();
+  size_t Close = Trimmed.rfind(')');
+  if (Close != StringRef::npos && Close + 1 < Trimmed.size()) {
+    StringRef Tail = Trimmed.substr(Close + 1).trim();
+    if (const char *Kind = exitKindForStatement(Tail))
+      return Kind;
+    if (Tail.starts_with("{"))
+      return findImmediateExitInSingleStatementBlock(IfLine + 1, Lines);
+  }
+
+  for (unsigned I = IfLine + 1; I < Lines.size() && I < IfLine + 6; ++I) {
+    StringRef Next = StringRef(Lines[I]).trim();
+    if (isIgnorableControlLine(Next))
+      continue;
+    return exitKindForStatement(Next);
+  }
+
+  return nullptr;
+}
+
+static const char *findImmediateExitOnFalseSide(
+    unsigned IfLine, const std::vector<std::string> &Lines) {
+  for (unsigned I = IfLine + 1; I < Lines.size() && I < IfLine + 10; ++I) {
+    StringRef Trimmed = StringRef(Lines[I]).trim();
+    if (Trimmed.empty() || Trimmed.starts_with("//") || Trimmed.starts_with("/*"))
+      continue;
+
+    if (!Trimmed.starts_with("else"))
+      continue;
+
+    StringRef Tail = Trimmed.drop_front(4).trim();
+    if (Tail.starts_with("if"))
+      return nullptr;
+    if (const char *Kind = exitKindForStatement(Tail))
+      return Kind;
+    if (Tail.starts_with("{") || Tail.empty())
+      return findImmediateExitInSingleStatementBlock(I + 1, Lines);
+    return nullptr;
+  }
+
+  return nullptr;
+}
+
+static bool shouldSkipLowValueGuardBranch(
+    const OneSidedBranchPoint &Point,
+    const std::vector<std::string> &Lines) {
+  if (Point.GroupType == BGT_Switch)
+    return false;
+  if (Point.Status == nullptr)
+    return false;
+
+  StringRef Status(Point.Status);
+  if (Status != "only_true" && Status != "only_false")
+    return false;
+  if (Point.Line == 0 || Point.Line >= Lines.size())
+    return false;
+
+  std::string IfCode = trimLineComment(Point.Code);
+  if (IfCode.empty() || !looksLikeNullGuardCondition(IfCode))
+    return false;
+
+  if (Status == "only_false")
+    return findImmediateExitOnTrueSide(Point.Line, Lines) != nullptr;
+  return findImmediateExitOnFalseSide(Point.Line, Lines) != nullptr;
+}
+
+// ============== 新增：查找case下第一个可执行语句 ==============
+// 返回: 第一个可执行语句的行号，如果找不到返回0
+// 注意：
+// - 对于fall-through case，会跳过连续的case/default标签，找到第一个实际语句
+// - 对于单行case（语句和标签在同一行），返回case行本身
+static unsigned findFirstStatementAfterCase(unsigned CaseLine,
+                                            const std::vector<std::string> &Lines,
+                                            std::string &FirstStmtCode) {
+  FirstStmtCode = "";
+
+  // 首先检查case行本身是否包含语句（单行case的情况）
+  if (CaseLine > 0 && CaseLine < Lines.size()) {
+    llvm::StringRef CaseLineStr = Lines[CaseLine];
+
+    // 查找冒号位置
+    size_t ColonPos = CaseLineStr.find(':');
+    if (ColonPos != llvm::StringRef::npos) {
+      // 获取冒号后的内容
+      llvm::StringRef AfterColon = CaseLineStr.substr(ColonPos + 1);
+
+      // 去掉前导空格
+      llvm::StringRef AfterColonTrimmed = AfterColon.ltrim();
+
+      // 检查是否有实际代码（不是空、不是注释、不是右花括号）
+      if (!AfterColonTrimmed.empty() &&
+          !AfterColonTrimmed.starts_with("//") &&
+          !AfterColonTrimmed.starts_with("/*") &&
+          !AfterColonTrimmed.starts_with("}")) {
+        // case行本身包含语句，返回case行号
+        FirstStmtCode = CaseLineStr.str();
+        return CaseLine;
+      }
+    }
+  }
+
+  // 从case行的下一行开始查找
+  // 跳过所有连续的case/default标签（支持fall-through case）
+  for (size_t i = CaseLine + 1; i < Lines.size(); ++i) {
+    llvm::StringRef Line(Lines[i]);
+
+    // 跳过空行
+    if (Line.trim().empty())
+      continue;
+
+    // 跳过注释行
+    llvm::StringRef Trimmed = Line.trim();
+    if (Trimmed.starts_with("//") || Trimmed.starts_with("/*"))
+      continue;
+
+    // 跳过单独的左花括号 {
+    if (Trimmed == "{")
+      continue;
+
+    // 如果遇到右花括号 }，说明switch结束了
+    if (Trimmed.starts_with("}"))
+      return 0;
+
+    // 跳过所有连续的case/default标签（fall-through support）
+    if (Trimmed.starts_with("case") || Trimmed.starts_with("default"))
+      continue;
+
+    // 找到第一个非空、非注释、非case/default的行，这就是case下的第一个语句
+    FirstStmtCode = Line.str();
+    return (unsigned)i;
+  }
+
+  return 0;
+}
+
+// ============== 原有函数备份（用于回退） ==============
+// 输出只执行了一侧的分支，包含行号、起始列、代码文本与覆盖状态
+// 返回原始数据，不进行排序
+static std::vector<OneSidedBranchPoint> collectFileOneSidedBranches_LEGACY(
+    const coverage::CoverageData &FC,
+    llvm::StringRef Filename) {
+  auto Lines = loadFileLines(Filename);
+  std::vector<OneSidedBranchPoint> BranchPoints;
+
+  for (const auto &B : FC.getBranches()) {
+    if (isLoopConditionBranch(B, Lines))
+      continue;
+    if (!isOneSidedBranch(B))
+      continue;
+
+    uint64_t TrueCount = B.ExecutionCount;
+    uint64_t FalseCount = B.FalseExecutionCount;
+
+    // 计算平均值
+    double Average = (static_cast<double>(TrueCount) + static_cast<double>(FalseCount)) / 2.0;
+
+    // 计算方差
+    double Variance = calculateVariance(TrueCount, FalseCount, Average);
+
+    // 1-based, 注意防越界
+    std::string Code;
+    if (B.LineStart > 0 && B.LineStart < Lines.size())
+      Code = Lines[B.LineStart];
+    else
+      Code = "";
+
+    const char *Status = "unknown";
+    if (TrueCount == 0 && FalseCount > 0)
+      Status = "only_false";
+    else if (TrueCount > 0 && FalseCount == 0)
+      Status = "only_true";
+
+    OneSidedBranchPoint Point;
+    Point.Filename = Filename.str();  // 保存文件名
+    Point.Line = B.LineStart;
+    Point.Col = B.ColumnStart;
+    Point.Code = Code;
+    Point.TrueCount = TrueCount;
+    Point.FalseCount = FalseCount;
+    Point.Status = Status;
+    Point.NumZeroSuccessors = 1;  // 只执行一侧，意味着恰好有一个分支为0
+    Point.SuccessorVariance = Variance;
+    Point.SuccessorAverage = Average;
+
+    BranchPoints.push_back(Point);
+  }
+
+  return BranchPoints;
+}
+
+// ============== 新版本：支持分支组识别 ==============
+
+// 分析switch分支组
+static void analyzeSwitchBranchGroup(
+    const std::vector<const coverage::CountedRegion*> &GroupBranches,
+    const std::vector<std::string> &Lines,
+    llvm::StringRef Filename,
+    std::vector<OneSidedBranchPoint> &BranchPoints) {
+
+  unsigned GroupSize = GroupBranches.size();
+
+  for (size_t i = 0; i < GroupBranches.size(); ++i) {
+    const auto *BR = GroupBranches[i];
+
+    // 跳过循环条件分支
+    if (isLoopConditionBranch(*BR, Lines))
+      continue;
+
+    // 提取case标签
+    std::string CaseLabel = extractCaseLabel(*BR, Lines);
+
+    uint64_t TrueCount = BR->ExecutionCount;
+    uint64_t FalseCount = BR->FalseExecutionCount;
+
+    // 检查是否完全未执行或只执行了一侧
+    bool Uncovered = (TrueCount == 0 && FalseCount == 0);
+    bool OneSided = isOneSidedBranch(*BR);
+
+    if (!Uncovered && !OneSided)
+      continue;  // 这个case已经完全覆盖，不是瓶颈
+
+    // 计算统计信息
+    double Average = (static_cast<double>(TrueCount) + static_cast<double>(FalseCount)) / 2.0;
+    double Variance = calculateVariance(TrueCount, FalseCount, Average);
+
+    std::string Code;
+    if (BR->LineStart > 0 && BR->LineStart < Lines.size())
+      Code = Lines[BR->LineStart];
+    else
+      Code = "";
+
+    const char *Status = "unknown";
+    if (Uncovered)
+      Status = "uncovered_case";
+    else if (TrueCount == 0 && FalseCount > 0)
+      Status = "only_false";
+    else if (TrueCount > 0 && FalseCount == 0)
+      Status = "only_true";
+
+    OneSidedBranchPoint Point;
+    Point.Filename = Filename.str();
+    Point.Line = BR->LineStart;
+    Point.Col = BR->ColumnStart;
+    Point.Code = Code;
+    Point.TrueCount = TrueCount;
+    Point.FalseCount = FalseCount;
+    Point.Status = Status;
+    Point.NumZeroSuccessors = Uncovered ? 2 : 1;
+    Point.SuccessorVariance = Variance;
+    Point.SuccessorAverage = Average;
+
+    // 分支组信息
+    Point.IsPartOfGroup = true;
+    Point.GroupType = BGT_Switch;
+    Point.GroupSize = GroupSize;
+    Point.GroupIndex = i;
+    Point.CaseLabel = CaseLabel;
+
+    // 查找对应的switch语句（传入整个分支组以利用CFG关系）
+    unsigned SwitchLine = 0;
+    Point.SwitchStatement = findSwitchStatement(BR->LineStart, Lines, SwitchLine, GroupBranches);
+    Point.SwitchStatementLine = SwitchLine;
+
+    // ============== 新增：查找case下第一个可执行语句 ==============
+    std::string FirstStmtCode;
+    Point.CaseBodyLine = findFirstStatementAfterCase(BR->LineStart, Lines, FirstStmtCode);
+    Point.CaseBodyCode = FirstStmtCode;
+
+    BranchPoints.push_back(Point);
+  }
+}
+
+// 新的收集函数：支持分支组识别
+static std::vector<OneSidedBranchPoint> collectFileOneSidedBranches(
+    const coverage::CoverageData &FC,
+    llvm::StringRef Filename,
+    bool SkipLowValueGuards) {
+
+  auto Lines = loadFileLines(Filename);
+  std::vector<OneSidedBranchPoint> BranchPoints;
+
+  auto Branches = FC.getBranches();
+  if (Branches.empty())
+    return BranchPoints;
+
+  // 第一步：识别并分组switch分支
+  std::set<size_t> Processed;
+  std::vector<const coverage::CountedRegion*> CurrentSwitchGroup;
+
+  for (size_t i = 0; i < Branches.size(); ++i) {
+    if (Processed.count(i))
+      continue;
+
+    const auto &B = Branches[i];
+
+    // 如果是switch分支，尝试找同一switch的其他case
+    if (isSwitchBranch(B, Lines)) {
+      CurrentSwitchGroup.clear();
+      CurrentSwitchGroup.push_back(&B);
+      Processed.insert(i);
+
+      // 找到对应的switch语句和它的结束行
+      int switchEndLine = -1;
+      unsigned firstCaseLine = B.LineStart;
+
+      // 利用分支组信息找到第一个case
+      for (const auto *BR : CurrentSwitchGroup) {
+        if (BR->LineStart < firstCaseLine) {
+          firstCaseLine = BR->LineStart;
+        }
+      }
+
+      // 从第一个case向上查找switch语句
+      for (int line = (int)firstCaseLine - 1; line >= 0 && line >= (int)firstCaseLine - 50; --line) {
+        llvm::StringRef Line(Lines[line]);
+        llvm::StringRef Trimmed = Line.trim();
+        if (Trimmed.starts_with("switch")) {
+          switchEndLine = findSwitchEndLine(line, Lines);
+          break;
+        }
+      }
+
+      // 查找同一switch内的所有case/default分支
+      if (switchEndLine > 0) {
+        // 使用switch的完整范围来分组
+        for (size_t j = i + 1; j < Branches.size(); ++j) {
+          if (Processed.count(j))
+            continue;
+
+          const auto &NextB = Branches[j];
+          // 检查是否在switch范围内且是switch分支
+          if (isSwitchBranch(NextB, Lines) &&
+              (int)NextB.LineStart <= switchEndLine &&
+              (int)NextB.LineStart >= (int)B.LineStart - 500) {
+            CurrentSwitchGroup.push_back(&NextB);
+            Processed.insert(j);
+          }
+        }
+      } else {
+        // 降级到使用距离限制（向后兼容）
+        for (size_t j = i + 1; j < Branches.size(); ++j) {
+          if (Processed.count(j))
+            continue;
+
+          const auto &NextB = Branches[j];
+          if (isSwitchBranch(NextB, Lines) &&
+              abs((int)NextB.LineStart - (int)B.LineStart) <= 100) {
+            CurrentSwitchGroup.push_back(&NextB);
+            Processed.insert(j);
+          }
+        }
+      }
+
+      // 分析这个switch组
+      if (CurrentSwitchGroup.size() > 1) {
+        analyzeSwitchBranchGroup(CurrentSwitchGroup, Lines, Filename, BranchPoints);
+      } else {
+        // 单独的switch分支，使用原有逻辑
+        goto SINGLE_BRANCH_PROCESSING;
+      }
+    } else {
+SINGLE_BRANCH_PROCESSING:
+      // 非switch分支或单独分支，使用原有逻辑
+      if (isLoopConditionBranch(B, Lines))
+        continue;
+      if (!isOneSidedBranch(B))
+        continue;
+
+      uint64_t TrueCount = B.ExecutionCount;
+      uint64_t FalseCount = B.FalseExecutionCount;
+
+      double Average = (static_cast<double>(TrueCount) + static_cast<double>(FalseCount)) / 2.0;
+      double Variance = calculateVariance(TrueCount, FalseCount, Average);
+
+      std::string Code;
+      if (B.LineStart > 0 && B.LineStart < Lines.size())
+        Code = Lines[B.LineStart];
+      else
+        Code = "";
+
+      const char *Status = "unknown";
+      if (TrueCount == 0 && FalseCount > 0)
+        Status = "only_false";
+      else if (TrueCount > 0 && FalseCount == 0)
+        Status = "only_true";
+
+      OneSidedBranchPoint Point;
+      Point.Filename = Filename.str();
+      Point.Line = B.LineStart;
+      Point.Col = B.ColumnStart;
+      Point.Code = Code;
+      Point.TrueCount = TrueCount;
+      Point.FalseCount = FalseCount;
+      Point.Status = Status;
+      Point.NumZeroSuccessors = 1;
+      Point.SuccessorVariance = Variance;
+      Point.SuccessorAverage = Average;
+
+      // 标记为非分支组
+      Point.IsPartOfGroup = false;
+      Point.GroupType = BGT_SingleIf;
+      Point.GroupSize = 1;
+      Point.GroupIndex = 0;
+
+      // 初始化新增字段
+      Point.CaseBodyLine = 0;
+      Point.CaseBodyCode = "";
+      Point.SwitchStatementLine = 0;
+
+      // 检查是否是else if，添加对应的if语句
+      llvm::StringRef CodeRef(Code);
+      if (CodeRef.contains("else if")) {
+        // 是else if，查找对应的if语句
+        Point.IfStatement = findIfStatement(B.LineStart, Lines);
+        Point.GroupType = BGT_IfElseChain;  // 标记为if-else链的一部分
+      }
+
+      if (SkipLowValueGuards && shouldSkipLowValueGuardBranch(Point, Lines))
+        continue;
+
+      BranchPoints.push_back(Point);
+    }
+  }
+
+  return BranchPoints;
+}
