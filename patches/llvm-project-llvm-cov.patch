+// 读取整个文件的行（1-based 索引，Lines[0] 留空）
+static std::vector<std::string> loadFileLines(StringRef Filename) {
+  std::vector<std::string> Lines(1);
+  auto MBOrErr = llvm::MemoryBuffer::getFile(Filename);
+  if (!MBOrErr)
+    return Lines;
+  llvm::line_iterator LI(*MBOrErr->get(), /*SkipBlanks=*/false);
+  for (; !LI.is_at_eof(); ++LI)
+    Lines.emplace_back(std::string(*LI));
+  return Lines;
+}
