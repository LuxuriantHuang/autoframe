+
+      llvm::sort(Branches, [&getQualityScore](const OneSidedBranchPoint &A,
+                                                 const OneSidedBranchPoint &B) {
+        double ScoreA = getQualityScore(A);
+        double ScoreB = getQualityScore(B);
+        if (ScoreA != ScoreB)
+          return ScoreA > ScoreB;
+
+        // 质量相同时，按行号排序（保证稳定性）
