+// 查找switch语句的结束行（通过括号匹配）
+static int findSwitchEndLine(unsigned SwitchLine,
+                            const std::vector<std::string> &Lines) {
+  int BraceCount = 0;
+  bool foundSwitchStart = false;
+
+  // 从switch行开始向下查找
+  for (size_t i = SwitchLine; i < Lines.size(); ++i) {
+    llvm::StringRef Line(Lines[i]);
+
+    // 统计括号数量
+    for (size_t j = 0; j < Line.size(); ++j) {
+      if (Line[j] == '{') {
+        BraceCount++;
+        foundSwitchStart = true;
+      } else if (Line[j] == '}') {
+        BraceCount--;
+        if (foundSwitchStart && BraceCount == 0) {
+          return (int)i;  // 返回switch结束行
+        }
+      }
+    }
+  }
+
+  return -1;  // 未找到匹配的结束括号
+}
+
+// 查找对应的switch语句（通过分支组关系查找）
+static std::string findSwitchStatement(unsigned CaseLine,
+                                      const std::vector<std::string> &Lines,
+                                      unsigned &SwitchLineOut,
+                                      const std::vector<const coverage::CountedRegion*> &SwitchGroup) {
+  SwitchLineOut = 0;
+
+  // 方法1: 利用分支组信息 - switch语句应该在第一个case之前
+  // 找到组内行号最小的case
+  unsigned MinCaseLine = CaseLine;
+  for (const auto *BR : SwitchGroup) {
+    if (BR->LineStart < MinCaseLine) {
+      MinCaseLine = BR->LineStart;
+    }
+  }
+
+  // 从第一个case向上查找switch语句（限制范围提高效率）
+  // switch通常离第一个case不远，最多查找50行
+  for (int i = (int)MinCaseLine - 1; i >= 0 && i >= (int)MinCaseLine - 50; --i) {
+    llvm::StringRef Line(Lines[i]);
+    llvm::StringRef Trimmed = Line.trim();
+
+    // 跳过空行和注释行
+    if (Trimmed.empty() || Trimmed.starts_with("//") || Trimmed.starts_with("/*"))
+      continue;
+
+    // 找到switch关键字
+    if (Trimmed.starts_with("switch")) {
+      // 找到switch语句的末尾（通常是{或)）
+      size_t EndPos = Trimmed.find('{');
+      if (EndPos == llvm::StringRef::npos) {
+        EndPos = Trimmed.find(')');
+        if (EndPos != llvm::StringRef::npos) {
+          EndPos++;  // 包含)
+        } else {
+          EndPos = Trimmed.size();
+        }
+      } else {
+        EndPos++;  // 包含{
+      }
+      SwitchLineOut = (unsigned)i;
+      return Trimmed.substr(0, EndPos).str();
+    }
+
+    // 如果遇到其他控制结构关键字，说明switch不在这一段
+    if (Trimmed.starts_with("if") || Trimmed.starts_with("for") ||
+        Trimmed.starts_with("while") || Trimmed.starts_with("do")) {
+      break;
+    }
+  }
+
+  return "";
+}
+
+// 查找对应的if语句（向上查找）
+static std::string findIfStatement(unsigned ElseLine,
+                                   const std::vector<std::string> &Lines) {
+  // 从else行向上查找if语句（最多查找10行）
+  for (int i = (int)ElseLine - 1; i >= 0 && i >= (int)ElseLine - 10; --i) {
+    llvm::StringRef Line(Lines[i]);
+    llvm::StringRef Trimmed = Line.trim();
+
+    // 查找不是else if的if语句
+    if (Trimmed.starts_with("if") && !Trimmed.starts_with("if(") &&
+        !Line.contains("else if")) {
+      // 提取完整的if语句（到{或行尾）
+      size_t EndPos = Trimmed.find('{');
+      if (EndPos == llvm::StringRef::npos) {
+        EndPos = Trimmed.size();
+      } else {
+        EndPos++;  // 包含{
+      }
+      return Trimmed.substr(0, EndPos).str();
+    }
+  }
+
+  return "";
+}
+
+// 检查是否有显式的else语句
+static bool hasExplicitElse(unsigned IfLine,
+                           const std::vector<std::string> &Lines) {
+  // 从if行开始向下查找else（最多查找10行）
+  for (size_t i = IfLine + 1; i < Lines.size() && i < IfLine + 10; ++i) {
+    llvm::StringRef Line(Lines[i]);
+    llvm::StringRef Trimmed = Line.trim();
+
+    // 如果找到else（不是else if），返回true
+    if (Trimmed.starts_with("else") && !Trimmed.starts_with("else if")) {
+      return true;
+    }
+
+    // 如果遇到不相关的语句（如新的if、switch），停止查找
+    // 但不要在遇到else if时停止
+    if ((Trimmed.starts_with("if") && !Trimmed.starts_with("if(")) ||
+        Trimmed.starts_with("switch")) {
+      break;
+    }
+  }
+
+  return false;
+}
