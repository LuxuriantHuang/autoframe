+
+// 检测是否是switch语句的case分支
+static bool isSwitchBranch(const coverage::CountedRegion &R,
+                          const std::vector<std::string> &Lines) {
+  if (R.LineStart == 0 || R.LineStart >= Lines.size())
+    return false;
+
+  llvm::StringRef Line(Lines[R.LineStart]);
+  // 去掉缩进
+  llvm::StringRef Trimmed = Line.ltrim();
+
+  // 检查是否包含case或default关键字
+  return Trimmed.starts_with("case") || Trimmed.starts_with("default");
+}
+
+// 检测是否是if-else if链中的后续分支
+static bool isElseIfBranch(const coverage::CountedRegion &R,
+                          const std::vector<std::string> &Lines) {
+  if (R.LineStart == 0 || R.LineStart >= Lines.size())
+    return false;
+
+  llvm::StringRef Line(Lines[R.LineStart]);
+  // 检查是否包含"else if"
+  return Line.contains("else if");
+}
