+// 提取case标签（用于switch语句）
+static std::string extractCaseLabel(const coverage::CountedRegion &R,
+                                    const std::vector<std::string> &Lines) {
+  if (R.LineStart == 0 || R.LineStart >= Lines.size())
+    return "unknown";
+
+  llvm::StringRef Line(Lines[R.LineStart]);
+
+  // 去掉缩进
+  llvm::StringRef Trimmed = Line.ltrim();
+
+  // 检查case
+  if (Trimmed.starts_with("case")) {
+    size_t ColonPos = Trimmed.find(':');
+    if (ColonPos != llvm::StringRef::npos) {
+      // 提取 "case X" 部分
+      return Trimmed.substr(0, ColonPos + 1).str();
+    }
+  }
+
+  // 检查default
+  if (Trimmed.starts_with("default")) {
+    size_t ColonPos = Trimmed.find(':');
+    if (ColonPos != llvm::StringRef::npos) {
+      return Trimmed.substr(0, ColonPos + 1).str();
+    }
+  }
+
+  return "unknown";
+}
