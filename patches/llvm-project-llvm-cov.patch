+// 将分支点数组转换为JSON数组（支持分支组信息）
+static json::Array convertBranchPointsToJSON(const std::vector<OneSidedBranchPoint> &BranchPoints) {
+  json::Array Arr;
+  for (const auto &Point : BranchPoints) {
+    json::Object Obj({
+        {"filename", Point.Filename},
+        {"line", static_cast<int64_t>(Point.Line)},
+        {"col",  static_cast<int64_t>(Point.Col)},
+        {"true_count", clamp_uint64_to_int64(Point.TrueCount)},
+        {"false_count", clamp_uint64_to_int64(Point.FalseCount)},
+        {"status", Point.Status},
+        {"code", Point.Code},
+    });
+
+    // 如果属于分支组，添加额外信息
+    if (Point.IsPartOfGroup) {
+      Obj["is_part_of_group"] = true;
+
+      // 添加组类型
+      const char *GroupTypeStr = "unknown";
+      if (Point.GroupType == BGT_Switch)
+        GroupTypeStr = "switch";
+      else if (Point.GroupType == BGT_IfElseChain)
+        GroupTypeStr = "if_else_chain";
+      else if (Point.GroupType == BGT_SingleIf)
+        GroupTypeStr = "single_if";
+
+      Obj["group_type"] = GroupTypeStr;
+      Obj["group_size"] = static_cast<int64_t>(Point.GroupSize);
+      Obj["group_index"] = static_cast<int64_t>(Point.GroupIndex);
+
+      // 对于switch，添加case标签
+      if (!Point.CaseLabel.empty() && Point.CaseLabel != "unknown") {
+        Obj["case_label"] = Point.CaseLabel;
+      }
+
+      // ============== 新增：对于switch，添加case下第一个基本块信息 ==============
+      if (Point.GroupType == BGT_Switch) {
+        // 始终输出这些字段，保持结构一致（值为0或空字符串表示未找到）
+        Obj["case_body_line"] = static_cast<int64_t>(Point.CaseBodyLine);
+        Obj["case_body_code"] = Point.CaseBodyCode;
+      }
+    } else {
+      Obj["is_part_of_group"] = false;
+    }
+
+    // 添加switch语句（对于switch类型始终输出，保持结构一致）
+    if (Point.GroupType == BGT_Switch) {
+      Obj["switch_statement"] = Point.SwitchStatement;
+      Obj["switch_statement_line"] = static_cast<int64_t>(Point.SwitchStatementLine);
+    } else {
+      // 非switch类型，只有在有值时才添加
+      if (!Point.SwitchStatement.empty()) {
+        Obj["switch_statement"] = Point.SwitchStatement;
+      }
+    }
+
+    // 添加if语句（如果有）
+    if (!Point.IfStatement.empty()) {
+      Obj["if_statement"] = Point.IfStatement;
+    }
+
+    Arr.push_back(std::move(Obj));
+  }
+  return Arr;
+}
