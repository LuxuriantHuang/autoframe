+// 仅一侧被执行的判定
+static bool isOneSidedBranch(const coverage::CountedRegion &R) {
+  uint64_t T = R.ExecutionCount;
+  uint64_t F = R.FalseExecutionCount;
+  return (T == 0) != (F == 0);
+}
+
+// 零覆盖分支判定：两侧都未执行
+static bool isZeroCoveredBranch(const coverage::CountedRegion &R) {
+  uint64_t T = R.ExecutionCount;
+  uint64_t F = R.FalseExecutionCount;
+  return (T == 0) && (F == 0);  // 与运算：两者都为0
+}
