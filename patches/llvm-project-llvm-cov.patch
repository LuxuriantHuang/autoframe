+void CodeCoverageTool::resolveDeferredSourceFiles(const CoverageMapping &Coverage) {
+  if (DeferredSourceFiles.empty())
+    return;
+
+  auto normalizePath = [](StringRef Path) -> std::string {
+    SmallString<128> NativePath(Path);
+    sys::path::native(NativePath);
+    sys::path::remove_dots(NativePath, true);
+    return std::string(NativePath);
+  };
+
+  for (const std::string &InputPath : DeferredSourceFiles) {
+    const std::string NormalizedInput = normalizePath(InputPath);
+    const StringRef InputRef(NormalizedInput);
+    const StringRef InputBase = sys::path::filename(InputRef);
+
+    std::string Match;
+    bool Ambiguous = false;
+
+    for (StringRef CoveredFile : Coverage.getUniqueSourceFiles()) {
+      const std::string NormalizedCovered = normalizePath(CoveredFile);
+      const StringRef CoveredRef(NormalizedCovered);
+
+      bool IsMatch = CoveredRef == InputRef ||
+                     (!InputBase.empty() && sys::path::filename(CoveredRef) == InputBase) ||
+                     CoveredRef.ends_with(InputRef);
+      if (!IsMatch)
+        continue;
+
+      if (Match.empty()) {
+        Match = NormalizedCovered;
+        continue;
+      }
+
+      if (Match != NormalizedCovered) {
+        Ambiguous = true;
+        break;
+      }
+    }
+
+    if (Ambiguous) {
+      warning("Source file is ambiguous, proceeded by ignoring it.", InputPath);
+      continue;
+    }
+
+    if (Match.empty()) {
+      warning("Source file doesn't exist, proceeded by ignoring it.", InputPath);
+      continue;
+    }
+
+    if (!IgnoreFilenameFilters.matchesFilename(Match))
+      SourceFiles.emplace_back(std::move(Match));
+  }
+
+  DeferredSourceFiles.clear();
+}
