+// 计算方差
+static double calculateVariance(uint64_t Val1, uint64_t Val2, double Avg) {
+  double Diff1 = static_cast<double>(Val1) - Avg;
+  double Diff2 = static_cast<double>(Val2) - Avg;
+  return (Diff1 * Diff1 + Diff2 * Diff2) / 2.0;
+}
