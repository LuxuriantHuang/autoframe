+// 新增：为没有行号信息的 BB 推断行号
+void TraceId::inferBBLines(Module &M) {
+    for (auto &F : M) {
+        if (isBlacklisted(&F)) continue;
+
+        u32 func_id = FunctionMap[&F];
+        u32 func_lineStart = Functions[func_id].lineStart;
+        u32 func_lineEnd = Functions[func_id].lineEnd;
+
+        for (auto &BB : F) {
+            u32 bb_id = LinearIdMap[&BB];
+            auto &bb_info = BasicBlocks[bb_id];
+
+            // 如果 BB 没有行号，尝试推断
+            if (bb_info.lineStart == 0 && bb_info.lineEnd == 0) {
+                // 策略1：使用函数的起始行号
+                if (func_lineStart != 0) {
+                    bb_info.lineStart = func_lineStart;
+                    bb_info.lineEnd = func_lineStart;
+                }
+
+                // 策略2：使用前驱 BB 的行号
+                bool inferred = false;
+                for (auto pred_bb : predecessors(&BB)) {
+                    u32 pred_id = LinearIdMap[pred_bb];
+                    if (BasicBlocks[pred_id].lineStart != 0) {
+                        bb_info.lineStart = BasicBlocks[pred_id].lineStart;
+                        bb_info.lineEnd = BasicBlocks[pred_id].lineEnd;
+                        inferred = true;
+                        break;
+                    }
+                }
+
+                // 策略3：使用后继 BB 的行号
+                if (!inferred) {
+                    for (auto succ_bb : successors(&BB)) {
+                        u32 succ_id = LinearIdMap[succ_bb];
+                        if (BasicBlocks[succ_id].lineStart != 0) {
+                            bb_info.lineStart = BasicBlocks[succ_id].lineStart;
+                            bb_info.lineEnd = BasicBlocks[succ_id].lineEnd;
+                            break;
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
