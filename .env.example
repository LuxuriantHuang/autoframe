AF_OUTPUT_DIR=out
AF_TEST_MODE=0

# Optional toolchain overrides for published core mode.
AF_AFL_PATH=
AF_SHOWMAP_BIN=
AF_LLVM_COV_BIN=
AF_LLVM_PROFDATA_BIN=
AF_LLVM_OPT_BIN=
AF_SVF_SLICE_PATH=

# Provider selector: qwen-max, qwen-long, qwen-coder, qwen-plus, deepseek-chat,
# deepseek-reasoner, kimi, glm5, glm-5, glm4.7, glm-4.7
AF_MODEL_PROVIDER=qwen-max

# Optional explicit override. Leave empty to use the default mapped model name.
AF_MODEL_NAME=

# Legacy generic override. Usually leave empty and use provider-specific values below.
AF_BASE_URL=
AF_API_KEY=

# DashScope / Qwen
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# DeepSeek
DEEPSEEK_BASE_URL=https://api.deepseek.com/beta
DEEPSEEK_API_KEY=

# Moonshot / Kimi
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=

# BigModel / GLM
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
BIGMODEL_API_KEY=
