#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import argparse
import json
from pathlib import Path
from typing import Any, Dict, List, Optional, Set, Tuple

from kaitaistruct import KaitaiStructError, EndOfStreamError

# 改成你的生成文件/类名（如果不是 png.py / Png）
from png import Png


def _dbg_start_end(dbg_entry: Any) -> Optional[Tuple[int, int]]:
    """Extract (start,end) from Kaitai --read-pos _debug entry."""
    if not isinstance(dbg_entry, dict):
        return None
    s = dbg_entry.get("start")
    e = dbg_entry.get("end")
    if isinstance(s, int) and isinstance(e, int) and e >= s:
        return s, e
    return None


def _is_kaitai_obj(x: Any) -> bool:
    """Heuristic: Kaitai struct objects have _debug and _io."""
    return hasattr(x, "_debug") and hasattr(x, "_io")


def collect_fields_abs(
    obj: Any,
    path_prefix: str = "",
    base_offset: int = 0,
    *,
    seen: Optional[Set[int]] = None,
) -> List[Dict[str, int]]:
    """
    Recursively collect fields with absolute offsets.
    - Field names follow parser field names (from _debug keys).
    - Absolute offset = base_offset + field_debug.start
    - If a child object uses a different _io (e.g., parsed from bytes slice),
      then its base_offset should jump to the parent's field absolute start.
    """
    if seen is None:
        seen = set()

    out: List[Dict[str, int]] = []

    oid = id(obj)
    if oid in seen:
        return out
    seen.add(oid)

    dbg = getattr(obj, "_debug", None)
    if not isinstance(dbg, dict):
        return out

    parent_io = getattr(obj, "_io", None)

    for field_name, dbg_entry in dbg.items():
        if field_name in ("_io", "_root", "_parent"):
            continue

        full_name = field_name if path_prefix == "" else f"{path_prefix}.{field_name}"

        # Get field value first to determine if it has children
        try:
            val = getattr(obj, field_name)
        except Exception:
            continue

        r = _dbg_start_end(dbg_entry)

        # Only add field if it's a leaf node (not a parent object or list with children)
        is_parent_object = _is_kaitai_obj(val)
        is_parent_list = isinstance(val, list) and val and _is_kaitai_obj(val[0])

        if r and not is_parent_object and not is_parent_list:
            rel_s, rel_e = r
            abs_s = base_offset + rel_s
            abs_e = base_offset + rel_e
            out.append({"name": full_name, "offset": int(abs_s), "size": int(abs_e - abs_s)})
        else:
            rel_s = None  # for mypy-ish clarity

        # list
        if isinstance(val, list):
            for i, item in enumerate(val):
                if not _is_kaitai_obj(item):
                    continue
                item_prefix = f"{full_name}[{i}]"

                item_io = getattr(item, "_io", None)
                if item_io is parent_io:
                    child_base = base_offset
                else:
                    # new stream: base jumps to parent's field abs start
                    child_base = base_offset + (r[0] if r else 0)

                out.extend(collect_fields_abs(item, item_prefix, child_base, seen=seen))
            continue

        # child object
        if _is_kaitai_obj(val):
            child_io = getattr(val, "_io", None)
            if child_io is parent_io:
                child_base = base_offset
            else:
                child_base = base_offset + (r[0] if r else 0)

            out.extend(collect_fields_abs(val, full_name, child_base, seen=seen))

    return out


def build_output(file_path: str) -> Dict[str, Any]:
    """
    Output format:
    {
      "file_path": "...",
      "fields": [{"name":..., "offset":..., "size":...}, ...]
    }
    """
    try:
        parsed = Png.from_file(file_path)
        fields = collect_fields_abs(parsed, path_prefix="", base_offset=0)

        # de-dup and sort by offset
        uniq = {}
        for f in fields:
            key = (f["name"], f["offset"], f["size"])
            uniq[key] = f
        fields = sorted(uniq.values(), key=lambda x: (x["offset"], x["name"]))

        return {"file_path": file_path, "fields": fields}

    except (EndOfStreamError, KaitaiStructError, UnicodeDecodeError, ValueError) as e:
        # 解析失败也按格式返回，只是 fields 为空，并附带 error（如果你不想要 error，可删）
        return {
            "file_path": file_path,
            "fields": [],
            "error": {"type": type(e).__name__, "message": str(e)},
        }


def main():
    ap = argparse.ArgumentParser(description="Dump Kaitai fields (parser-consistent names) with absolute offsets.")
    ap.add_argument("input", help="input file path")
    ap.add_argument("-o", "--output", default="fields.json", help="output json path (default: fields.json)")
    args = ap.parse_args()

    out = build_output(args.input)
    Path(args.output).write_text(json.dumps(out, ensure_ascii=False, indent=2), encoding="utf-8")
    print(f"Wrote -> {args.output}")


if __name__ == "__main__":
    main()
